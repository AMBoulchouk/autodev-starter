#!/usr/bin/env bash
set -e

echo "========================================="
echo " [autodev] Project Inspection Diagnostic"
echo "========================================="

echo "Directory     : $(pwd)"
echo "Platform      : POSIX / $(uname -s)"

# 1. Git Status
if [ -d ".git" ]; then
    BRANCH=$(git branch --show-current 2>/dev/null || echo "initial")
    [ -z "$BRANCH" ] && BRANCH="initial"
    echo "Git           : Initialized (branch: $BRANCH)"
else
    echo "Git           : Not initialized"
fi

# 2. Governance files
MISSING_GOV=""
for f in ".autodev/manifest.yaml" ".autodev/architecture.md" "AGENTS.md"; do
    if [ ! -f "$f" ]; then
        MISSING_GOV="$MISSING_GOV $f"
    fi
done

if [ -z "$MISSING_GOV" ]; then
    echo "Governance    : All core governance files present"
else
    echo "Governance    : Missing:$MISSING_GOV"
fi

# 3. Project Driver
if [ -f ".autodev/runtime.yaml" ]; then
    echo "Project Driver: .autodev/runtime.yaml present"
else
    echo "Project Driver: Not configured (missing .autodev/runtime.yaml)"
fi

# 4. State Machine
if [ -f ".autodev/state/progress.json" ]; then
    PHASE=$(grep -o '"phase"[[:space:]]*:[[:space:]]*"[^"]*"' .autodev/state/progress.json | sed -E 's/.*"phase"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/' || echo "unknown")
    echo "Phase         : $PHASE"
else
    echo "Phase         : Uninitialized"
fi

# 5. Product Brief
if [ -f "PRODUCT_BRIEF.md" ]; then
    echo "Product Brief : PRODUCT_BRIEF.md present"
else
    echo "Product Brief : Not found"
fi

echo "========================================="
exit 0
