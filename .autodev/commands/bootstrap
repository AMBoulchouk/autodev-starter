#!/usr/bin/env bash
set -e

echo "========================================="
echo " [autodev] Engine Bootstrap"
echo "========================================="

# 1. Initialize Git if missing
if [ ! -d ".git" ]; then
    echo "[bootstrap] Initializing Git repository..."
    git init
else
    echo "[bootstrap] Git repository already present."
fi

# 2. Ensure directories exist
mkdir -p .autodev/state .autodev/evidence .autodev/features .autodev/domain .autodev/policies

# 3. Initialize progress.json
STATE_FILE=".autodev/state/progress.json"
NEEDS_INIT=1
if [ -f "$STATE_FILE" ]; then
    if grep -q '"version"[[:space:]]*:[[:space:]]*2' "$STATE_FILE"; then
        NEEDS_INIT=0
    fi
fi

TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date +"%Y-%m-%dT%H:%M:%SZ")

if [ "$NEEDS_INIT" -eq 1 ]; then
    cat <<EOF > "$STATE_FILE"
{
  "version": 2,
  "phase": "specification",
  "current_feature": null,
  "features": {},
  "last_cycle": {
    "validate": null,
    "test": null,
    "build": null,
    "verify": null
  },
  "last_updated": "$TIMESTAMP"
}
EOF
    echo "[bootstrap] Initialized progress.json (phase: specification)."
fi

# 4. Ensure runtime.yaml template exists
if [ ! -f ".autodev/runtime.yaml" ]; then
    cat <<EOF > ".autodev/runtime.yaml"
version: 1

environment:
  setup: ""
  install: ""

commands:
  validate: ""
  test: ""
  build: ""
  run: ""
  verify: ""
  preview: ""

health:
  command: ""
  expected_exit_code: 0
EOF
    echo "[bootstrap] Created driver template: .autodev/runtime.yaml"
fi

echo ""
echo "[bootstrap:agent-responsibilities]"
echo "AutoDev Engine bootstrap complete. The Agent must now:"
echo "1. Read PRODUCT_BRIEF.md (or inspect existing code)."
echo "2. Model domain (.autodev/domain/) and record ADRs (.autodev/state/decisions.md)."
echo "3. Configure project commands in .autodev/runtime.yaml."
echo "4. Decompose features under .autodev/features/ and run .autodev/commands/plan."
echo "========================================="
exit 0
