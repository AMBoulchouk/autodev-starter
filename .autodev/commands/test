#!/usr/bin/env bash
set -e

echo "========================================="
echo " [autodev] Test Contract Runner"
echo "========================================="

# 1. Check phase from progress.json
if [ -f ".autodev/state/progress.json" ]; then
    PHASE=$(grep -o '"phase": *"[^"]*"' .autodev/state/progress.json | cut -d'"' -f4 || echo "")
    if [ "$PHASE" = "bootstrap" ] || [ "$PHASE" = "specification" ]; then
        echo "[test:info] Project is in '$PHASE' phase. Skipping tests until implementation begins."
        exit 0
    fi
fi

# 2. Node.js
if [ -f "package.json" ]; then
    if grep -q '"test":' package.json; then
        echo "[test] Executing: npm test"
        npm test
        exit $?
    fi
fi

# 3. Python
if [ -f "pyproject.toml" ] || [ -f "requirements.txt" ]; then
    if command -v pytest >/dev/null 2>&1; then
        echo "[test] Executing: pytest"
        pytest
        exit $?
    else
        echo "[test] Executing: python3 -m unittest discover"
        python3 -m unittest discover
        exit $?
    fi
fi

# 4. Go
if [ -f "go.mod" ]; then
    echo "[test] Executing: go test ./..."
    go test ./...
    exit $?
fi

# 5. Rust
if [ -f "Cargo.toml" ]; then
    echo "[test] Executing: cargo test"
    cargo test
    exit $?
fi

echo "[test:notice] No test framework detected yet. Exiting 0."
exit 0
